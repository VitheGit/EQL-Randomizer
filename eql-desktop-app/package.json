{
  "name": "eql-legends-randomizer",
  "version": "1.0.69",
  "description": "EQ Legends Randomizer - character randomizer with log-file death/level tracking",
  "main": "main.js",
  "author": "EQ Legends Randomizer",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.eqlegends.randomizer",
    "productName": "EQ Legends Randomizer",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "VitheGit",
      "repo": "EQL-Randomizer",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
